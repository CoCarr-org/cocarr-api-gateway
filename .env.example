# cocarr-api-gateway — environment
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# --- Upstream services (base URLs; gateway rewrites /v1/<prefix> -> /v1) ------
IDENTITY_SERVICE_URL=http://localhost:3050
AUTHORIZATION_SERVICE_URL=http://localhost:3060
WORKSPACE_SERVICE_URL=http://localhost:3040
CORE_SERVICE_URL=http://localhost:3030
NOTIFICATION_SERVICE_URL=http://localhost:3070

# --- CORS (comma-separated browser origins; empty = reflect any) -------------
CORS_ORIGINS=https://admin.cocarr.com,https://workspace.cocarr.com,https://cocarr.com

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- JWT verification (Firebase admin project; same as the services) ---------
# JSON string (one line) or a path. Unset => dev mode (no verification).
ADMIN_SERVICE_ACCOUNT=
AUTH_DISABLED=false
