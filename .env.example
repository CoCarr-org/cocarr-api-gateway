# cocarr-api-gateway — environment
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# --- Upstream services (base URLs; gateway rewrites /v1/<prefix> -> /v1) ------
IDENTITY_SERVICE_URL=http://localhost:3050
AUTHORIZATION_SERVICE_URL=http://localhost:3060
WORKSPACE_SERVICE_URL=http://localhost:3040
CORE_SERVICE_URL=http://localhost:3030
NOTIFICATION_SERVICE_URL=http://localhost:3070

# --- CORS (comma-separated browser origins; empty = reflect any) -------------
CORS_ORIGINS=https://admin.cocarr.com,https://workspace.cocarr.com,https://cocarr.com

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- JWT verification (Firebase admin project; same as the services) ---------
# JSON string (one line) or a path.
# UNSET IS NOT A DEV MODE: every protected route answers 503 until this is set.
ADMIN_SERVICE_ACCOUNT=

# Dev-only bypass. IGNORED when NODE_ENV=production, so a stray `true` promoted
# to a production environment cannot open the platform up.
AUTH_DISABLED=false

# --- Trusted edge <-> service contract ---------------------------------------
# Shared secret proving a request reached a service THROUGH this gateway. The
# SAME value must be set as GATEWAY_KEY on identity/authorization/workspace/
# notification. With it, services trust x-user-id / x-identity-id from the
# gateway and skip a second Firebase verification. Without it they fall back to
# verifying the bearer token themselves — correct, just slower.
# Generate with:  openssl rand -hex 32
GATEWAY_KEY=
